<style>
.mobile-menu-icon{display: none;}
.mobile-menu-icon {
    cursor: pointer;
}
.navbar-wraper {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.logo-link{display: flex;}
.top-navbar {
	background: #F5F5F5;
	padding: 14px 0px;
	position: relative;
}
.logo{width: 150px;}
.logo img{width: 100%;}
.cta-button a {
  position: relative;
	background: #FFF544;
	color: #000;
	text-decoration: none;
	padding: 8px 14px;
	display: inline-flex;
	align-items: center;
	gap: 8px;
	overflow: hidden;
	z-index: 0;
	transition: color 0.35s ease;
}
.cta-button a::before {
	content: "";
	position: absolute;
	top: 0;
	left: 0;
	height: 100%;
	width: 100%;
	background: #1a1a1a;
	transform: scaleX(0);
	transform-origin: left;
	transition: transform 0.35s ease;
	z-index: -1;
}
.cta-button a:hover::before {
	transform: scaleX(1);
}
.cta-button a:hover {
color: #f2ea1a;
}
.cta-button a:hover.btn-arrow:hover svg path{fill:#f2ea1a; }

.cta-button svg {
	width: 18px;
}
.caption {
	font-size: 16px;
}


.mobile-menu {
	display: none;
	background: #F5F5F5;
	border-top: 1px solid #E0E0E0;
	box-shadow: 0 8px 16px rgba(0,0,0,0.08);
	padding: 20px 16px;
	text-align: center;
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 999;
}
.mobile-menu.active {
	display: block;
}
.mobile-menu .caption {
	display: block;
	margin-bottom: 16px;
}
.mobile-menu .cta-button {
	display: block;
}
.mobile-menu .cta-button a {
	justify-content: center;
	width: 100%;
	box-sizing: border-box;
}
.icon-close {
	display: none;
}

@media only screen and (max-width: 767px){
    .logo-wraper {
	text-align: center;
	justify-content: center;
	display: flex;
}
.navbar-wraper {
	display: grid;
	grid-template-columns: 6% 100%;
	align-items: center;
}
.cta-button {
	display: none;
}
.caption {
	font-size: 16px;
	display: none;
}
 .mobile-menu-icon{display: block;}
}

</style>

<div class="top-navbar">
<div class="inner-navbar page-width">

  <div class="navbar-wraper">
    <div class="mobile-menu-icon" id="mobileMenuIcon">
        <svg id="iconHamburger" width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1 6H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1 1H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1 11H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
        <svg id="iconClose" class="icon-close" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1 1L15 15" stroke="black" stroke-width="2" stroke-linecap="round"/>
<path d="M15 1L1 15" stroke="black" stroke-width="2" stroke-linecap="round"/>
</svg>
    </div>
    <div class="logo-wraper">
        <div class="logo">
            <a href="/" class="logo-link">
            <img src="{{ section.settings.logo | img_url : 'master' }}">
            </a>
        </div>
    </div>
    <div class="caption">
        {{ section.settings.caption }}
    </div>
    <div class="cta-button">
        <a href="{{ section.settings.button-url }}">{{section.settings.button-text}} <span class="btn-arrow"><svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg></span></a>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <div class="caption">{{ section.settings.caption }}</div>
    <div class="cta-button">
        <a href="{{ section.settings.button-url }}">{{section.settings.button-text}} <span class="btn-arrow"><svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg></span></a>
    </div>
  </div>

</div>
</div>



{% schema %}
{
  "name": "header",
  "settings": [
    {
    "type": "image_picker",
    "id": "logo",
    "label": "Upload Logo"
    },
    {
    "type": "text",
    "id": "caption",
    "label": "Caption Text"
    },
    {
    "type": "text",
    "id": "button-text",
    "label": "Button Text"
    },
     {
    "type": "url",
    "id": "button-url",
    "label": "Button URL"
    }
  ]
}
{% endschema %}