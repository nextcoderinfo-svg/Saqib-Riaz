
<style>
  .logo {width: 150px;}
</style>

<div class="main-banner">
  <div class="banner-inner">
<div class="top-navbar">
  <div class="logo-wraper">
    <div class="logo">
      <img src="{{ section.settings.logo | img_url : 'master' }}">
    </div>
  </div>
  <div class="caption">{{ section.settings.caption }}</div>
  <div class="cta-button">
    <a href="{{ section.settings.button-url }}">{{section.settings.button-text}}</a>
  </div>
</div>
  </div>
</div>

{% schema %}
{
  "name": "Banner",
  "settings": [
{
"type": "image_picker",
"id": "logo",
"label": "Upload logo"
},
{
"type": "text",
"id": "caption",
"label": "Caption Text"
},{
"type": "text",
"id": "button-text",
"label": "Button Text"
},{
"type": "url",
"id": "button-url",
"label": "Button URL"
}
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}