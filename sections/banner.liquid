
<style>
.top-navbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 8px 0px;
}
.main-banner {
	background: #F5F5F5;
}
  .logo {width: 150px;display: flex;}
  .logo img{width: 100%;}
.cta-button a {
	background: #FFF544;
	padding: 8px 20px;
	color: #000;
	text-decoration: none;
	display: flex;
	gap: 10px;
}
.button-arrow svg {
  width: 20px;
}
  .caption {
	font-size: 16px;
}
.banner-inner img{width: 100%;}
.banner {
	min-height: 600px;
}
.banner-image {
	position: relative;
}
.overlay-content {
	position: absolute;
	bottom: 10%;
	left: 0;
	max-width: 500px;
}
.overlay-content h2 {
	font-size: 70px;
	font-weight: 500;margin: 0px;
}
.overlay-content p {
	font-size: 20px;
	line-height: 28px;
}
.shop-btn a {
	background: #000;
	color: #fff;
	padding: 10px 20px;
	text-decoration: none;
}
</style>

<div class="main-banner">
  <div class="banner-inner page-width">
<div class="top-navbar">
  <div class="logo-wraper">
    <div class="logo">
      <img src="{{ section.settings.logo | img_url : 'master' }}">
    </div>
  </div>
  <div class="caption">{{ section.settings.caption }}</div>
  <div class="cta-button">
    <a href="{{ section.settings.button-url }}">{{section.settings.button-text}}<span class="button-arrow"><svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg>
</span></a>
  </div>
</div>
  </div>
</div>
<div class="banner-wraper">
  <div class="banner-inner">
    <div class="banner">
      <img src="{{ section.settings.Bannerimage | img_url : 'master' }}">
      </div>
    <div class="banner-image page-width">
      <div class="overlay-content">
        <h2>The Gift Guide</h2>
        <p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
        <div class="shop-btn">
         <a href=""> Shop Now <span class="button-arrow"><svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg>
</span></a>
        </div>
      </div>
    </div>
  </div>
</div>



{% schema %}
{
  "name": "Banner",
  "settings": [
{
"type": "image_picker",
"id": "logo",
"label": "Upload logo"
},
{
"type": "text",
"id": "caption",
"label": "Caption Text"
},{
"type": "text",
"id": "button-text",
"label": "Button Text"
},{
"type": "url",
"id": "button-url",
"label": "Button URL"
},
{
"type": "image_picker",
"id": "Bannerimage",
"label": "Upload Banner Image"
},
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}