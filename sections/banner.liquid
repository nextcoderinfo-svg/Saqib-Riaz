<style>
.navbar-wraper {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.top-navbar {
	background: #F5F5F5;
	padding: 14px 0px;
}
.logo{width: 150px;}
.logo img{width: 100%;}
</style>

<div class="top-navbar">
<div class="inner-navbar page-width">
  
  <div class="navbar-wraper">
    <div class="logo-wraper">
        <div class="logo">
            <img src="{{ section.settings.logo | img_url : 'master' }}">
        </div>
    </div>
    <div class="caption">
        {{ section.settings.caption }}
    </div>
    <div class="cta-button">
        <a href="#">choose gift</a>
    </div>
  </div>

</div>    
</div>


{% schema %}
{
  "name": "Banner",
  "settings": [
    {
    "type": "image_picker",
    "id": "logo",
    "label": "Upload Logo"
    },
    {
    "type": "text",
    "id": "caption",
    "label": "Caption Text"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}