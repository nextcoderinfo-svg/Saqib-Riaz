<style>
.navbar-wraper {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.logo-link{display: flex;}
.top-navbar {
	background: #F5F5F5;
	padding: 14px 0px;
}
.logo{width: 150px;}
.logo img{width: 100%;}
.cta-button a {
	background: #FFF544;
	color: #000;
	text-decoration: none;
	padding: 10px 14px;
}
.cta-button svg {
	width: 18px;
}
.caption {
	font-size: 16px;
}
.banner-image img {
	width: 100%;
	height: 100%;
}
.inner-banner {
	position: relative;
}
.overlay-content {
	position: absolute;
	bottom: 10%;max-width: 500px;
}
.heading h2 {
	font-size: 70px;
	font-weight: 500;margin: 0;
}
.content p {
	font-size: 20px;
	line-height: 28px;
}
.shop-btn a {
	background: #000;
	color: #fff;
	text-decoration: none;
	padding: 10px;
}
.shop-btn svg path {
	fill: #fff;
}
.shop-btn svg {
width: 20px;
}
</style>

<div class="top-navbar">
<div class="inner-navbar page-width">
  
  <div class="navbar-wraper">
    <div class="logo-wraper">
        <div class="logo">
            <a href="/" class="logo-link">
            <img src="{{ section.settings.logo | img_url : 'master' }}">
            </a>
        </div>
    </div>
    <div class="caption">
        {{ section.settings.caption }}
    </div>
    <div class="cta-button">
        <a href="{{ section.settings.button-url }}">{{section.settings.button-text}} <span class="btn-arrow"><svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg></span></a>
    </div>
  </div>

</div>    
</div>

<div class="main-banner">
    <div class="inner-banner">
        <div class="banner-image">
            {% if section.settings.banner-image  %}
             <img src="{{ section.settings.banner-image | img_url : 'master' }}">
             {% endif %}
        </div>
        <div class="main-content page-width">
        <div class="overlay-content">
            <div class="heading">
                <h2>{{ section.settings.title }}</h2>
            </div>
             <div class="content">
                {{ section.settings.content }}
             </div>
              <div class="shop-btn">
<a href="{{ section.settings.shop-btn-url }}">{{section.settings.shop-btn-text}} <span class="btn-arrow"><svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg></span></a>
              </div>
        </div>
    </div>
    </div>
</div>






{% schema %}
{
  "name": "Banner",
  "settings": [
    {
    "type": "image_picker",
    "id": "logo",
    "label": "Upload Logo"
    },
    {
    "type": "text",
    "id": "caption",
    "label": "Caption Text"
    },
    {
    "type": "text",
    "id": "button-text",
    "label": "Button Text"
    },
     {
    "type": "url",
    "id": "button-url",
    "label": "Button URL"
    },
    {
    "type": "image_picker",
    "id": "banner-image",
    "label": "Upload Banner Image"
    },
    {
    "type": "text",
    "id": "title",
    "label": "Heading"
    },
    {
    "type": "richtext",
    "id": "content",
    "label": "content"
    },
    {
    "type": "text",
    "id": "shop-btn-text",
    "label": "Button Text"
    },
     {
    "type": "url",
    "id": "shop-btn-url",
    "label": "Button URL"
    },
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}