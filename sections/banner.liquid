<style>
  .logo{width: 150px;display: flex;}
  .logo img {width: 100%;}
  .top-nav {
  display: flex;
  justify-content: space-between;align-items: center;
}
.main-banner {
background: #F5F5F5;
  padding: 18px;
}
.caption {
	font-size: 16px;
	line-height: 13px;
}
.cta-button a{
	background: #FFF544;
	padding: 10px 20px;
	color: #000;
	text-decoration: none;
}
</style>


<div class="main-banner">
<div class="banner-innner page-width">
<div class="top-nav">
  <div class="logo">
    <img src="{{ section.settings.logo | img_url : 'master' }}">
  </div>
  <div class="caption">
{{ section.settings.caption }}
  </div>
  <div class="cta-button">
<a href="{{ section.settings.button-url }}">{{ section.settings.button-text }}</a>
  </div>
</div>
</div>
</div>

{% schema %}
{
  "name": "Banner",
  "settings": [
{
  "type": "image_picker",
"id": "logo",
"label": "Upload logo"
},
{
"type": "text",
"id": "caption",
"label": "Caption text"
},
{
"type": "text",
"id": "button-text",
"label": "Button Title"
},
{
"type": "url",
"id": "button-url",
"label": "Button-url"
}
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}