<style>
  .logo{width: 80px;}
  .logo img {width: 100%;}
</style>


<div class="main-banner">
<div class="banner-innner">
<div class="top-nav">
  <div class="logo">
    <img src="{{ section.settings.logo | img_url : 'master' }}">
  </div>
  <div class="caption">
{{ section.settings.caption }}
  </div>
  <div class="cta-button">
<a href="{{ section.settings.button-url }}">{{ section.settings.button-text }}</a>
  </div>
</div>
</div>
</div>

{% schema %}
{
  "name": "Banner",
  "settings": [
{
  "type": "image_picker",
"id": "logo",
"label": "Upload logo"
},
{
"type": "text",
"id": "caption",
"label": "Caption text"
},
{
"type": "text",
"id": "button-text",
"label": "Button Title"
},
{
"type": "url",
"id": "button-url",
"label": "Button-url"
}
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}