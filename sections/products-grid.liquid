<style>
    .grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;gap: 16px;
}
.product-image img {
	width: 100%;
}
.grid-heading h2 {
	font-size: 36px;
}
.quick-view {
	position: absolute;
	background: #fff;
	border-radius: 100%;
	padding: 4px 4px;
	line-height: 0;cursor: pointer;
}
.grid-box {
	position: relative;
}
.product_image img{width: 100%;}
.popupcontent {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}
.quick-view-content {
	width: 500px;
	margin: 0 auto;
	position: fixed;
	left: 0;
	right: 0;
	overflow: hidden;
	background: #fff;
}
.product-info p {
  line-height: 16px;
}
.close {
	position: absolute;
	right: 10px;
}
@media only screen and (max-width: 767px){
    .grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.grid-heading h2 {
	font-size: 24px;text-align: center;
}
}
</style>
<div class="grid-wraper">
    <div class="grid-inner page-width">
        <div class="grid-heading">
            <h2>{{section.settings.title }}</h2>
        </div>
        <div class="grid-container">
         {%for block in section.blocks %}  
            {% assign product = block.settings.product %} 
        <div class="grid-box">
            <div class="product-container">
                <div class="product-image">
                    <img src="{{ product.featured_image | img_url : 'master' }}">
                </div>
            </div>
            <div class="quick-view" style="left : {{ block.settings.x_position }}%;top:{{ block.settings.y_position }}%; "><svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4.98047 0.75V9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M0.75 4.98071H9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
</div>
        </div>
{% endfor %}
    </div>
    </div>
     {%for block in section.blocks %}  
            {% assign product = block.settings.product %} 
    <div class="quick-view-content">
        <div class="close">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4.24219 4.24279L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M4.24219 12.7278L12.7275 4.24249" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>

        </div>
        <div class="popupcontent">
            <div class="product-image">
                 <div class="product_image">
                    <img src="{{ product.featured_image | img_url : 'master' }}">
                </div>
            </div>
            <div class="product-info">
                <h3>{{ product.title }}</h3>
                <span>{{ product.price | money}}</span>
                <p>{{ product.description }}</p>
            </div>
{% for option in product.option_with_values %}
    {{ option.name }}
    {% endfor %}
        </div>
    </div>
</div>
{% endfor %}

{% schema %}
{
	"name": "Products Grid",
	"settings": [
		{
        "type": "text",
        "id": "title",
        "label": "Title"
        },
	],
    "blocks": [
        {
        "type": "product",
        "name": "product",
        "settings": [
		{
        "type": "product",
        "id": "product",
        "label": "Linked product"
        },
        {
        "type": "range",
        "id": "x_position",
        "label": "Hotspot horizontal Position",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
        },{
        "type": "range",
        "id": "y_position",
        "label": "Hotspot vertical Position",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
        }
	],
        }
    ],
    
	"presets": [
		{
			"name": "Products Grid"
		}
	]
}
{% endschema %}
