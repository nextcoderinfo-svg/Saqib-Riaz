<style>
.close {
	cursor: pointer;
	position: absolute;
	top: 10px;
	right: 10px;
	z-index: 2;
}
.grid-container {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr;
	gap: 16px;
}
.product-image img {
	width: 100%;
	display: block;
}
.grid-heading h2 {
	font-size: 36px;
}
.quick-view {
	position: absolute;
	background: #fff;
	border-radius: 100%;
	padding: 6px;
	line-height: 0;
	cursor: pointer;
	transform: translate(-50%, -50%);
}
.grid-box {
	position: relative;
}

/* ---------------- Quick view popup ---------------- */
.quick-view-overlay {
	position: fixed;
	inset: 0;
	background: rgba(0, 0, 0, 0.5);
	display: none;
	z-index: 998;
}
.quick-view-overlay.active {
	display: block;
}
.quick-view-content {
	width: 500px;
	max-width: 90vw;
	max-height: 85vh;
	overflow-y: auto;
	margin: 0 auto;
	position: fixed;
	top: 50%;
	left: 0;
	right: 0;
	transform: translateY(-50%);
	background: #fff;
	padding: 24px;

	z-index: 999;
}
.quick-view-content.active {
	display: block;
}
.popupcontent {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 15px;
}
.popupcontent .product-image img {
	width: 100%;
}
.product-info p {
	line-height: 16px;
	font-size: 13px;
	color: #444;
}
.product-info h3 {
	margin: 0 0 8px;
}
.product-info .qv-price {
	display: block;
	font-weight: 600;
	margin-bottom: 12px;
}
.option-label {
	display: block;
	font-size: 12px;
	text-transform: uppercase;
	color: #666;
	margin: 14px 0 6px;
}
.colorvariant .option-values {
	display: flex;
}
.colorvariant input[type="radio"] {
	position: absolute;
	opacity: 0;
	width: 0;
	height: 0;
}
.colorvariant label {
	border: solid 1px #ccc;
	width: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 10px 0;
	cursor: pointer;
	margin: 0;
	font-size: 13px;
}
.colorvariant input[type="radio"]:checked + label {
	background: #000;
	color: #fff;
	border-color: #000;
}
.qv-select {
	width: 100%;
	padding: 10px;
	border: 1px solid #ccc;
	background: #fff;
	font-size: 14px;
}
.add-to-cart-btn {
	width: 100%;
	margin-top: 18px;
	background: #000;
	color: #fff;
	border: none;
	padding: 14px;
	font-size: 14px;
	letter-spacing: 0.03em;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
}
.add-to-cart-btn:disabled {
	background: #999;
	cursor: not-allowed;
}

@media only screen and (max-width: 767px) {
	.grid-container {
		grid-template-columns: 1fr 1fr;
	}
	.grid-heading h2 {
		font-size: 24px;
		text-align: center;
	}
	.popupcontent {
		grid-template-columns: 1fr;
	}
	.quick-view-content {
		padding: 16px;
	}
}
</style>

<div class="quick-view-overlay" id="qvOverlay"></div>

<div class="grid-wraper">
	<div class="grid-inner page-width">
		<div class="grid-heading">
			<h2>{{ section.settings.title }}</h2>
		</div>
		<div class="grid-container">
			{% for block in section.blocks %}
				{% assign product = block.settings.product %}
				<div class="grid-box">
					<div class="product-container">
						<div class="product-image">
							{% if product != blank %}
								<img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title | escape }}">
							{% endif %}
						</div>
					</div>
					{% if product != blank %}
						<div
							class="quick-view js-qv-open"
							data-target="quick-view-{{ forloop.index }}"
							style="left: {{ block.settings.x_position }}%; top: {{ block.settings.y_position }}%;"
						>
							<svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M4.98047 0.75V9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
								<path d="M0.75 4.98071H9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
							</svg>
						</div>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</div>
</div>

{% for block in section.blocks %}
	{% assign product = block.settings.product %}
	{% if product != blank %}
		<div class="quick-view-content" id="quick-view-{{ forloop.index }}">
			<div class="close js-qv-close">
				<svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.24219 4.24279L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
					<path d="M4.24219 12.7278L12.7275 4.24249" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
				</svg>
			</div>
			<div class="popupcontent">
				<div class="product-image">
					<img class="qv-image" src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title | escape }}">
				</div>
				<div class="product-info">
					<h3>{{ product.title }}</h3>
					<span class="qv-price">{{ product.price | money }}</span>
					<p>{{ product.description }}</p>

				
				</div>


			</div>
	{% for option in product.options_with_values %}
						{% if option.name contains 'Color' or option.name contains 'color' %}
						
						{% else %}
							
						{% endif %}
					{% endfor %}

					<button type="button" class="add-to-cart-btn js-add-to-cart" disabled>
						<span class="btn-label">Add to cart</span> <span>&rarr;</span>
					</button>
			
		
		</div>
	{% endif %}
{% endfor %}



{% schema %}
{
	"name": "Products Grid",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title"
		}
	],
	"blocks": [
		{
			"type": "product",
			"name": "Product",
			"settings": [
				{
					"type": "product",
					"id": "product",
					"label": "Linked product"
				},
				{
					"type": "range",
					"id": "x_position",
					"label": "Hotspot horizontal position",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 50
				},
				{
					"type": "range",
					"id": "y_position",
					"label": "Hotspot vertical position",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 50
				}
			]
		}
	],
	"presets": [
		{
			"name": "Products Grid"
		}
	]
}
{% endschema %}
