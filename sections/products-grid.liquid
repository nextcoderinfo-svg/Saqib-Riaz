<style>
    .grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;gap: 16px;
}
.product-image img {
	width: 100%;
}
</style>
<div class="grid-wraper">
    <div class="grid-inner page-width">
        <div class="grid-heading">
            <h2>Tisso vison in the wild</h2>
        </div>
        <div class="grid-container">
         {%for block in section.blocks %}  
            {% assign product = block.settings.product %} 
        <div class="grid-box">
            <div class="product-container">
                <div class="product-image">
                    <img src="{{ product.featured_image | img_url : 'master' }}">
                </div>
            </div>
            <div class="quick-view"><svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle cx="11" cy="11" r="11" fill="#F8F8F8" fill-opacity="0.9"/>
</svg>
</div>
        </div>
{% endfor %}
    </div>
    </div>
</div>


{% schema %}
{
	"name": "Products Grid",
	"settings": [
		
	],
    "blocks": [
        {
        "type": "product",
        "name": "product",
        "settings": [
		{
        "type": "product",
        "id": "product",
        "label": "Linked product"
        }
	],
        }
    ],
    
	"presets": [
		{
			"name": "Products Grid"
		}
	]
}
{% endschema %}
